<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.ultikits.plugins</groupId>
        <artifactId>ultibot-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>ultibot-v1_21_R1</artifactId>
    <name>UltiBot NMS 1.21-1.21.1</name>

    <!-- Coverage: not measured, and deliberately so (phase 09 D-10 exclusion). This submodule
         depends on a BuildTools-produced remapped-mojang Spigot artifact (see the spigot dependency
         below, classifier remapped-mojang) that is built on the CI runner from source, not resolved
         from any Maven repository a plain local build can reach, so it cannot execute (compile or
         test) in a runner that has not first run SpigotMC BuildTools for this exact Minecraft
         version. This is a capability limit, not a coverage judgement: no coverage-instrumentation
         plugin reference is added here, and none should be. -->

    <properties>
        <!-- NMS module needs Java 21 to compile against 1.21.x server classes -->
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.ultikits.plugins</groupId>
            <artifactId>ultibot-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot</artifactId>
            <!-- 13-REVIEW-UltiBot.md WR-02: version hoisted to the reactor root pom.xml's
                 ultibot.v1_21_R1.spigot.version property; see that file for why, and keep
                 ultibot-core/pom.xml's test-scope copy of this dependency on the same property. -->
            <version>${ultibot.v1_21_R1.spigot.version}</version>
            <classifier>remapped-mojang</classifier>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>
</project>
